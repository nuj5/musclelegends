-- Onyx GUI (muscle farm port). Made by JustH0bo.
-- Sourced: functions, remotes, arguments, intervals, radii from the original script; UI calls from the Onyx README;
-- stat names from the leaderboard header screenshot; reset behavior from the user's description.
-- ASSUMED: stats live under player.leaderstats as numeric values; Onyx handles are method-style;
-- Credits field meanings (Name / Title / Label); the Backpack instance can be replaced on respawn.
-- UNTUNED: RebirthInterval, ToolSettleTime, SettleMaxWait, ResetWaitTimeout, RecentResetWindow, server rate limits.

for _, key in ipairs({ "OnyxGUI", "Potassium" }) do
    local old = getgenv()[key]
    if old then
        pcall(function() old:Destroy() end)
    end
end

local Config = {
    LibraryUrl           = "https://raw.githubusercontent.com/nuj5/onyx/refs/heads/main/onyx.lua",
    ToolPriority         = { "Pushups", "Weight" },
    LockPosition         = Vector3.new(-8741.34, 23.68, -5854.70),
    TeleLockRadius       = 5,
    PosLockRadius        = 3,
    ActivateGap          = 0.1,
    LoopStep             = 0.05,
    EquipSettle          = 0.2,
    RepInterval          = 0.1,
    HousekeepingInterval = 0.5,
    ReequipEvery         = 4,    -- housekeeping ticks, 4 x 0.5s = 2s like the original
    SlowInterval         = 10,   -- gift + size
    GiftSlots            = 8,
    RebirthInterval      = 0.25, -- UNTUNED: fixed seconds between rebirth requests (was 5)
    RebirthStatName      = "Rebirths",
    ToolSettleTime       = 0.5,  -- UNTUNED: tools must be unchanged this long before the farm resumes
    SettleMaxWait        = 6,    -- UNTUNED: give up waiting for tools after this long
    ResetWaitTimeout     = 5,    -- UNTUNED: max wait for the character reset after a rebirth signal
    RecentResetWindow    = 1.5,  -- UNTUNED: a stat rise this soon after a respawn counts as already reset
    StatsFolder          = "leaderstats",                                 -- ASSUMED container
    StatNames            = { "Strength", "Rebirths", "Kills", "Brawls" }, -- from leaderboard header
    StatsInterval        = 1,
}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local backpack = player:WaitForChild("Backpack")
local character = player.Character
local humanoid = character and character:FindFirstChildOfClass("Humanoid")

local S: { [string]: any } = {
    running = false,
    paused = false,
    stopped = false,
    rebirthEnabled = false,
    teleLock = false,
    posLock = false,
    settling = false,          -- true from a reset signal until the new character's tools are stable
    settleReason = nil,        -- "rebirth" or "respawn"
    settleToken = 0,           -- invalidates older settle waits
    newCharSeen = false,
    lastCharAddedAt = -math.huge,
    lastToolChange = os.clock(),
    currentTarget = nil,
    lastActivation = 0,
    toolsDirty = true,
    posLockPosition = Vector3.zero,
}

local R: { [string]: any } = {}    -- remotes, resolved lazily
local UI: { [string]: any } = {}   -- Onyx control handles
local lastText: { [string]: string } = {}
local threads = {}                 -- cancellable farm threads
local mainThread = nil
local statsThread = nil
local bgRunning = false
local backpackConns = {}
local characterConns = {}
local conns = {}
local humanoidConn = nil
local destroyed = false
local startedAt = os.clock()
local rebirthStat = { object = nil, last = nil, conn = nil }

-- pure helpers
local function formatNumber(n)
    if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
        return "n/a"
    end
    local sign = n < 0 and "-" or ""
    local digits = string.format("%.0f", math.abs(n))
    local grouped = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    grouped = (grouped:gsub("^,", ""))
    return sign .. grouped
end

local function formatDuration(seconds)
    local total = math.max(0, math.floor(seconds))
    return string.format("%d:%02d:%02d", total // 3600, (total % 3600) // 60, total % 60)
end

-- counts increases only, so a reset or drop never shows as negative
local function accumulateGain(entry, value)
    if entry.last ~= nil and value > entry.last then
        entry.gained += value - entry.last
    end
    entry.last = value
end

-- Onyx handle call (method style, assumed)
local function callHandle(handle, method, ...)
    local fn = handle and handle[method]
    if type(fn) ~= "function" then
        return
    end
    local ok, err = pcall(fn, handle, ...)
    if not ok then
        warn("[OnyxGUI] " .. method .. " failed: " .. tostring(err))
    end
end

local function uiSet(name, value)
    if UI[name] then
        callHandle(UI[name], "Set", value, true)
    end
end

local function setLabel(key, text)
    local handle = UI[key]
    if not handle or lastText[key] == text then
        return
    end
    lastText[key] = text
    callHandle(handle, "SetText", text)
end

-- status
local function computeStatus()
    if not S.running then return "● IDLE" end
    if S.paused then return "⏸  PAUSED" end
    if S.settling then
        if S.settleReason == "rebirth" then return "✦  REBIRTHING" end
        return "↻  RESPAWNING"
    end
    if S.currentTarget then return "▶  " .. S.currentTarget:upper() end
    return "◎  SEARCHING"
end

local function refreshStatus()
    setLabel("status", computeStatus())
end

-- session stats
local Stats = {}
for _, name in ipairs(Config.StatNames) do
    Stats[name] = { last = nil, current = nil, gained = 0 }
end

local function readStat(name)
    local folder = player:FindFirstChild(Config.StatsFolder)
    local object = folder and folder:FindFirstChild(name)
    if object and object:IsA("ValueBase") then
        local value = (object :: any).Value
        if type(value) == "number" and value == value then
            return value
        end
    end
    return nil
end

local function updateStats()
    for _, name in ipairs(Config.StatNames) do
        local entry = Stats[name]
        local value = readStat(name)
        entry.current = value
        if value ~= nil then
            accumulateGain(entry, value)
        end
        setLabel("stat_" .. name, name .. ": " .. formatNumber(entry.current) .. "  (+" .. formatNumber(entry.gained) .. ")")
    end
    setLabel("session", "Session: " .. formatDuration(os.clock() - startedAt))
end

-- remotes
local function resolveRemotes()
    R.muscle = R.muscle or player:FindFirstChild("muscleEvent")
    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    if rEvents then
        R.gift    = R.gift    or rEvents:FindFirstChild("freeGiftClaimRemote")
        R.rebirth = R.rebirth or rEvents:FindFirstChild("rebirthRemote")
        R.size    = R.size    or rEvents:FindFirstChild("changeSpeedSizeRemote")
    end
end

-- tool change watchers: Backpack and character are watched separately because the Backpack can be replaced
local function markTools()
    S.toolsDirty = true
    S.lastToolChange = os.clock()
end

local function clearConns(list)
    for _, c in ipairs(list) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(list)
end

local function watchContainer(container, bucket)
    if not container then
        return
    end
    local function onChange(child)
        if child:IsA("Tool") then
            markTools()
        end
    end
    table.insert(bucket, container.ChildAdded:Connect(onChange))
    table.insert(bucket, container.ChildRemoved:Connect(onChange))
end

local function bindBackpackWatchers()
    clearConns(backpackConns)
    watchContainer(backpack, backpackConns)
    markTools()
end

local function bindCharacterWatchers()
    clearConns(characterConns)
    watchContainer(character, characterConns)
    markTools()
end

-- always use the current Backpack; rebind its watchers if the instance was replaced
local function refreshBackpack()
    local current = player:FindFirstChildOfClass("Backpack")
    if current and current ~= backpack then
        backpack = current
        bindBackpackWatchers()
    end
    return backpack
end

-- tool helpers
local function findTool(parent, name)
    if not parent then
        return nil
    end
    local direct = parent:FindFirstChild(name)
    if direct and direct:IsA("Tool") then
        return direct
    end
    if direct then
        -- something that is not a Tool shares the name: scan for the Tool like the original script did
        for _, child in ipairs(parent:GetChildren()) do
            if child.Name == name and child:IsA("Tool") then
                return child
            end
        end
    end
    return nil
end

local function isAvailable(name)
    if not character then
        return false
    end
    return findTool(character, name) ~= nil or findTool(refreshBackpack(), name) ~= nil
end

local function resolveDesired()
    for _, name in ipairs(Config.ToolPriority) do
        if isAvailable(name) then
            return name
        end
    end
    return nil
end

local function tryEquip(name)
    if not humanoid or not character or S.settling then
        return nil
    end
    local inChar = findTool(character, name)
    if inChar then
        return inChar
    end
    local inBag = findTool(refreshBackpack(), name)
    if not inBag then
        return nil
    end
    pcall(function() humanoid:EquipTool(inBag) end)
    task.wait(Config.EquipSettle)
    return findTool(character, name)
end

local function unequipAllExcept(name)
    local bag = refreshBackpack()
    if not character or not bag then
        return
    end
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") and item.Name ~= name then
            pcall(function() item.Parent = bag end)
        end
    end
end

local function unequipAll()
    unequipAllExcept(nil)
end

local function activate(tool)
    if not tool then
        return
    end
    local now = os.clock()
    if now - S.lastActivation < Config.ActivateGap then
        return
    end
    S.lastActivation = now
    pcall(tool.Activate, tool)
end

local function snapTo(pos)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function() root.CFrame = CFrame.new(pos) end)
    end
end

local function enforceLocks()
    if not (S.teleLock or S.posLock) then
        return
    end
    if S.paused or S.stopped or S.settling or not character then
        return
    end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    if S.teleLock and (root.Position - Config.LockPosition).Magnitude > Config.TeleLockRadius then
        snapTo(Config.LockPosition)
    end
    if S.posLock and (root.Position - S.posLockPosition).Magnitude > Config.PosLockRadius then
        snapTo(S.posLockPosition)
    end
end

-- reset / rebirth settle gate: the farm stays off the tools until the new character's tools stop changing
local function waitForToolsSettled(token, maxWait)
    local startedWait = os.clock()
    while token == S.settleToken and os.clock() - startedWait < maxWait do
        if os.clock() - S.lastToolChange >= Config.ToolSettleTime and resolveDesired() ~= nil then
            return true
        end
        task.wait(0.05)
    end
    return false
end

local function finishSettle(token)
    if token ~= S.settleToken then
        return
    end
    S.settling = false
    S.settleReason = nil
    S.toolsDirty = true
    if S.teleLock then
        snapTo(Config.LockPosition)
    end
    if S.posLock then
        snapTo(S.posLockPosition)
    end
    refreshStatus()
end

local function beginSettle(reason, newCharSeen)
    if destroyed then
        return
    end
    if S.settling then
        if reason == "rebirth" and S.settleReason ~= "rebirth" then
            S.settleReason = "rebirth"
            refreshStatus()
        end
        if newCharSeen then
            S.newCharSeen = true
        end
        return
    end

    S.settling = true
    S.settleReason = reason
    S.newCharSeen = newCharSeen == true
    S.settleToken += 1
    local token = S.settleToken
    refreshStatus()

    task.spawn(function()
        -- phase 1: the reset has not happened yet, wait for the new character (bounded)
        local waitStart = os.clock()
        while token == S.settleToken and not S.newCharSeen and os.clock() - waitStart < Config.ResetWaitTimeout do
            task.wait(0.05)
        end
        -- phase 2: wait until the tool set stops changing (bounded)
        if token == S.settleToken and S.newCharSeen then
            waitForToolsSettled(token, Config.SettleMaxWait)
        end
        finishSettle(token)
    end)
end

local function bindHumanoid(hum)
    if humanoidConn then
        pcall(function() humanoidConn:Disconnect() end)
        humanoidConn = nil
    end
    humanoidConn = hum.Died:Connect(function()
        beginSettle("respawn", false)
    end)
end

-- early rebirth signal: the Rebirths stat rising (ASSUMED to exist under leaderstats)
local function bindRebirthStat()
    local folder = player:FindFirstChild(Config.StatsFolder)
    local object = folder and folder:FindFirstChild(Config.RebirthStatName)
    if object == rebirthStat.object then
        return
    end
    if rebirthStat.conn then
        rebirthStat.conn:Disconnect()
        rebirthStat.conn = nil
    end
    rebirthStat.object = object
    rebirthStat.last = nil
    if not object or not object:IsA("ValueBase") then
        return
    end
    local initial = (object :: any).Value
    if type(initial) == "number" then
        rebirthStat.last = initial
    end
    rebirthStat.conn = object:GetPropertyChangedSignal("Value"):Connect(function()
        local current = (object :: any).Value
        if type(current) ~= "number" then
            return
        end
        local previous = rebirthStat.last
        rebirthStat.last = current
        if previous ~= nil and current > previous then
            beginSettle("rebirth", os.clock() - S.lastCharAddedAt < Config.RecentResetWindow)
        end
    end)
    table.insert(conns, rebirthStat.conn)
end

-- character handlers
local function onCharacterAdded(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    refreshBackpack()
    bindCharacterWatchers()
    bindHumanoid(humanoid)
    S.lastCharAddedAt = os.clock()
    beginSettle("respawn", true)
end

local function onCharacterRemoving()
    beginSettle("respawn", false)
end

-- main farm loop
local function startMainLoop()
    if mainThread then
        return
    end
    S.paused = false
    S.currentTarget = nil
    S.lastActivation = 0
    S.toolsDirty = true

    mainThread = task.spawn(function()
        local desired = nil
        while S.running and not S.stopped do
            if S.settling or S.paused then
                task.wait(0.05)
                continue
            end

            local char = player.Character
            if not char then
                task.wait(0.2)
                continue
            end
            if char ~= character or not humanoid or humanoid.Parent ~= char then
                character = char
                humanoid = char:FindFirstChildOfClass("Humanoid")
            end
            if not humanoid then
                task.wait(0.2)
                continue
            end

            if S.toolsDirty or not desired then
                S.toolsDirty = false
                desired = resolveDesired()
            end
            if not desired then
                task.wait(0.5)
                continue
            end

            if desired ~= S.currentTarget then
                unequipAllExcept(desired)
                S.currentTarget = desired
                refreshStatus()
                task.wait(Config.EquipSettle)
                continue
            end

            local tool = findTool(character, desired) or tryEquip(desired)
            activate(tool)
            task.wait(Config.LoopStep)
        end
        mainThread = nil
    end)
end

-- background loops
local function startBackgroundLoops()
    if bgRunning then
        return
    end
    bgRunning = true

    -- rep spam
    table.insert(threads, task.spawn(function()
        while not S.stopped do
            if S.running and not S.paused and not S.settling then
                R.muscle = R.muscle or player:FindFirstChild("muscleEvent")
                if R.muscle then
                    pcall(R.muscle.FireServer, R.muscle, "rep")
                end
            end
            task.wait(Config.RepInterval)
        end
    end))

    -- free gift + size change (each invoke runs in its own task, one in flight at a time)
    table.insert(threads, task.spawn(function()
        local idx, giftBusy, sizeBusy = 1, false, false
        while not S.stopped do
            resolveRemotes()
            if R.gift and not giftBusy then
                giftBusy = true
                local slot = idx
                task.spawn(function()
                    pcall(R.gift.InvokeServer, R.gift, "claimGift", slot)
                    giftBusy = false
                end)
            end
            idx = idx % Config.GiftSlots + 1
            if R.size and not sizeBusy then
                sizeBusy = true
                task.spawn(function()
                    pcall(R.size.InvokeServer, R.size, "changeSize", 1)
                    sizeBusy = false
                end)
            end
            task.wait(Config.SlowInterval)
        end
    end))

    -- rebirth: fast requests, never while a reset / tool refresh is in progress
    table.insert(threads, task.spawn(function()
        while not S.stopped do
            if S.rebirthEnabled and R.rebirth and not S.settling then
                pcall(R.rebirth.InvokeServer, R.rebirth, "rebirthRequest")
            end
            task.wait(Config.RebirthInterval)
        end
    end))

    -- housekeeping: Backpack check + position locks every tick, re-equip fallback every ReequipEvery ticks
    table.insert(threads, task.spawn(function()
        local tickCount = 0
        while not S.stopped do
            refreshBackpack()
            enforceLocks()
            tickCount += 1
            if tickCount % Config.ReequipEvery == 0 then
                S.toolsDirty = true
                local target = S.currentTarget
                if S.running and not S.settling and not S.paused
                    and character and target and not findTool(character, target) then
                    task.spawn(tryEquip, target)
                end
            end
            task.wait(Config.HousekeepingInterval)
        end
    end))
end

-- state setters
local function startRun()
    if S.running then
        return
    end
    S.stopped = false
    S.running = true
    S.paused = false
    startMainLoop()
    startBackgroundLoops()
    uiSet("Start", true)
    refreshStatus()
end

local function stopEverything()
    S.stopped = true
    S.running = false
    S.paused = false
    S.rebirthEnabled = false
    S.teleLock = false
    S.posLock = false
    S.settling = false
    S.settleReason = nil
    S.settleToken += 1
    S.currentTarget = nil
    bgRunning = false

    if mainThread then
        pcall(task.cancel, mainThread)
        mainThread = nil
    end
    for _, t in ipairs(threads) do
        pcall(task.cancel, t)
    end
    table.clear(threads)

    if character then
        unequipAll()
    end

    for _, name in ipairs({ "Start", "Pause", "Rebirth", "Lock" }) do
        uiSet(name, false)
    end
    refreshStatus()
end

local function setPaused(value)
    if value and not S.running then
        uiSet("Pause", false)
        return
    end
    if S.paused == value then
        return
    end
    S.paused = value
    uiSet("Pause", value)
    refreshStatus()
end

local function setRebirth(value)
    if S.rebirthEnabled == value then
        return
    end
    S.rebirthEnabled = value
    uiSet("Rebirth", value)
end

-- one button, both locks: teleport to LockPosition, then hold that spot with the position lock
local function setLock(value)
    if S.teleLock == value and S.posLock == value then
        return
    end
    if value then
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then
            uiSet("Lock", false)
            return
        end
        snapTo(Config.LockPosition)
        S.posLockPosition = root.Position
    end
    S.teleLock = value
    S.posLock = value
    uiSet("Lock", value)
end

-- lifecycle object (declared before the UI so OnUnload can reach it)
local OnyxGUI = {}
function OnyxGUI:Destroy()
    if destroyed then
        return
    end
    destroyed = true
    stopEverything()
    if statsThread then
        pcall(task.cancel, statsThread)
        statsThread = nil
    end
    if humanoidConn then
        pcall(function() humanoidConn:Disconnect() end)
        humanoidConn = nil
    end
    clearConns(backpackConns)
    clearConns(characterConns)
    clearConns(conns)
end
getgenv().OnyxGUI = OnyxGUI

-- UI
local function buildUi()
    local Onyx = loadstring(game:HttpGet(Config.LibraryUrl))()

    local Window = Onyx:CreateWindow({
        Id       = "OnyxGUI",
        Title    = "Onyx GUI",
        Credits  = { Name = "JustH0bo", Title = "Onyx GUI", Label = "Made by" }, -- field meanings ASSUMED
        OnUnload = function() OnyxGUI:Destroy() end,
    })

    local Tab = Window:AddTab("Main")

    local Controls = Tab:AddCard({ Title = "Controls", Subtitle = "farm loop", Column = "Left" })
    UI.status = Controls:AddLabel({ Text = computeStatus() })
    UI.Start = Controls:AddToggle({
        Label = "Start loop", Default = false, Flag = "Start",
        Callback = function(value)
            if value then
                startRun()
            else
                stopEverything()
            end
        end,
    })
    UI.Pause = Controls:AddToggle({
        Label = "Pause", Default = false, Flag = "Pause",
        Callback = function(value) setPaused(value) end,
    })
    UI.Rebirth = Controls:AddToggle({
        Label = "Rebirth", Default = false, Flag = "Rebirth",
        Callback = function(value) setRebirth(value) end,
    })
    UI.Lock = Controls:AddToggle({
        Label = "Tele + pos lock", Default = false, Flag = "Lock",
        Callback = function(value) setLock(value) end,
    })
    Controls:AddButton({ Label = "Stop all", Danger = true, Callback = stopEverything })

    local StatsCard = Tab:AddCard({ Title = "Session stats", Subtitle = "since the script started", Column = "Right" })
    UI.session = StatsCard:AddLabel({ Text = "Session: 0:00:00" })
    for _, name in ipairs(Config.StatNames) do
        UI["stat_" .. name] = StatsCard:AddLabel({ Text = name .. ": ..." })
    end
end

local uiOk, uiErr = pcall(buildUi)
if not uiOk then
    warn("[OnyxGUI] UI build failed: " .. tostring(uiErr))
end

resolveRemotes()
bindBackpackWatchers()
bindCharacterWatchers()
table.insert(conns, player.ChildAdded:Connect(function(child)
    if child:IsA("Backpack") then
        refreshBackpack()
    end
end))
table.insert(conns, player.CharacterAdded:Connect(onCharacterAdded))
table.insert(conns, player.CharacterRemoving:Connect(onCharacterRemoving))
if player.Character then
    task.spawn(onCharacterAdded, player.Character)
end
startBackgroundLoops()

statsThread = task.spawn(function()
    while not destroyed do
        bindRebirthStat()
        updateStats()
        task.wait(Config.StatsInterval)
    end
end)
